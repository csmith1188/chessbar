<!DOCTYPE html>
<html lang='en'>

<head>
    <meta charset='UTF-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <title>Pay - Chessbar</title>
    <link rel="stylesheet" href="/css/colors.css">
    <link rel='stylesheet' href='/css/pay.css'>
</head>

<script src='/socket.io/socket.io.js'></script>
<script src='js/socket.js'></script>

<script>
    function getCookie(name) {
        const nameEQ = name + "=";
        const ca = document.cookie.split(';');
        for (let i = 0; i < ca.length; i++) {
            let c = ca[i];
            while (c.charAt(0) === ' ') {
                c = c.substring(1, c.length); // Remove leading spaces
            }
            if (c.indexOf(nameEQ) === 0) {
                // Decode the cookie value
                return decodeURIComponent(c.substring(nameEQ.length, c.length));
            }
        }
        return null; // Return null if the cookie is not found
    }

    // If the user has quick pay on, skip everything else and automatically buy stuff
    const joinCode = new URLSearchParams(window.location.search).get('code')

    const cookiePIN = getCookie('pin')

    if (cookiePIN) {
        // Auto-buy: request 1 token and wait for the transferResponse for success/failure
        const expected = 1
        let results = []

        const handleResp = (res) => {
            results.push(res)
            if (results.length === expected) {
                socket.off('transferResponse', handleResp)
                const allGood = results.every(r => r && r.success === true)
                if (allGood) {
                    if (joinCode) {
                        window.location.href = `/game?code=${joinCode}`
                    } else {
                        window.location.href = '/'
                    }
                } else {
                    console.error('Payment failed:', results)
                    alert('Payment failed. Please check your PIN and try again.')
                }
            }
        }

        socket.on('transferResponse', handleResp)
        socket.emit('purchaseToken', parseInt(cookiePIN) || null, expected)
    }

</script>

<body class="with-sidebar">
    <%- include('partials/sidebar') %>
        <div id='buyTokens' class='panel'>
            <h3>Purchase tokens</h3>
            <p>You do not have any tokens. Play cost is 1 token.</p>
            <input type='password' inputmode='numeric' pattern='[0-9]*' placeholder='Your PIN...' id='pinInput'
                class='input'>
            <input type='number' placeholder='Amount?' id='amount' class='input' min='1' value='1'>

            <div class='checkbox-row'>
                <input type='checkbox' id='saveToCookies' name='box'>
                <label for='saveToCookies'>Save PIN for quick pay?</label>
            </div>

            <div class='actions'>
                <button id='submit' class='btn'>Buy (<%= PLAY_PRICE %>)</button>
            </div>
        </div>

        <a href='/' id='back-link'
            style='position:fixed;bottom:12px;left:12px;z-index:1000;padding:8px 12px;background:rgba(0,0,0,0.7);color:#fff;border-radius:4px;text-decoration:none;font-family:inherit;'>Back
            to game selection</a>

        <%- include('partials/notificationPopup') %>
</body>


<script src='/js/sidebar.js'></script>

<script>
    const pinBox = document.getElementById('pinInput')
    const amount = document.getElementById('amount')
    const checkbox = document.getElementById('saveToCookies')
    const submit = document.getElementById('submit')

    if (getCookie('pin')) checkbox.checked = true

    // guard: prevent buying less than 1 token
    submit.addEventListener('click', (e) => {
        const val = parseInt(amount.value) || 1
        if (val > 0) {
            const expected = val
            let results = []

            const handleResp = (res) => {
                results.push(res)
                if (results.length === expected) {
                    socket.off('transferResponse', handleResp)
                    const allGood = results.every(r => r && r.success === true)
                    if (allGood) {
                        if (checkbox.checked) {
                            const exp = new Date()
                            exp.setFullYear(exp.getFullYear() + 1)
                            document.cookie = `pin=${encodeURIComponent(pinBox.value.trim())}; expires=${exp.toUTCString()}; path=/`
                        } else {
                            document.cookie = `pin=0`
                        }
                        if (joinCode) {
                            window.location.href = `/game?code=${joinCode}`
                        } else {
                            window.location.href = '/'
                        }
                    } else {
                        console.error('Payment failed:', results)
                        alert('Payment failed for one or more tokens. Please check your PIN and try again.')
                    }
                }
            }

            socket.on('transferResponse', handleResp)
            socket.emit('purchaseToken', parseInt(pinBox.value) || null, val)
        }
    })
</script>

</html>