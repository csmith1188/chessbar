<link rel='stylesheet' href='/css/sidebar.css'>

<div class="global-sidebar" data-sidebar>
  <button class="sidebar-toggle" type="button" data-sidebar-toggle aria-expanded="true" aria-label="Collapse sidebar">
       <span class="hamburger" aria-hidden="true" style="display:none">
         <svg width="20" height="20" viewBox="0 0 20 20" fill="none" xmlns="http://www.w3.org/2000/svg">
           <rect y="4" width="20" height="2" rx="1" fill="currentColor"/>
           <rect y="9" width="20" height="2" rx="1" fill="currentColor"/>
           <rect y="14" width="20" height="2" rx="1" fill="currentColor"/>
         </svg>
       </span>
       <span class="chevron" aria-hidden="true"><</span>
       <span class="close-x" aria-hidden="true" style="display:none">&#10005;</span>
  </button>

  <div class="sidebar-inner">
    <div class="sidebar-brand">
      <div class="sidebar-mark">Chessbar</div>
      <div class="sidebar-subtitle">
        <% if (typeof user !== 'undefined' && user) { %>
          Signed in as <strong><%= user.displayName || user.display_name || user.email || 'Player' %></strong>
        <% } else { %>
          You are browsing as a guest
        <% } %>
      </div>
    </div>

    <nav class="sidebar-nav" aria-label="Primary">
      <a href="/" class="sidebar-link">Select a game</a>
      <a href="/profile" class="sidebar-link">
        Profile
        <% if (typeof unreadNotifCount !== 'undefined' && unreadNotifCount > 0) { %>
          <span class="notif-badge"><%= unreadNotifCount %></span>
        <% } %>
      </a>
      <% if (typeof user === 'undefined' || !user) { %>
        <a href="/login" class="sidebar-link">Sign in</a>
      <% } %>
      <% const uid = user && (user.id || user.formbar_id || user.user_id); %>
      <% if (uid && [37, 40].includes(Number(uid))) { %>
        <a href="/admin" class="sidebar-link">Admin</a>
      <% } %>
    </nav>
  </div>
</div>

<script src='/js/sidebar.js'></script>
