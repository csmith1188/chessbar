<!DOCTYPE html>
<html lang='en'>

<head>
    <meta charset='UTF-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <title>Profile - Chessbar</title>
    <link rel='stylesheet' href='/css/profile.css'>
</head>

<body>
    <div id="player">
        <div class="avatar-large">
            <img id="pfp" src="/img/basic_avatar.png">

        </div>

        <div id="name"></div>
        <div id="btn-wrap">
            <button id="friends-btn" class="btn secondary"> <img src="/img/emoji-1.png" class="friend-emoji">Add
                Friend<img src="/img/emoji-1.png" class="friend-emoji"></button>
            <button id="challenge-btn" class="btn secondary">⚔️ Challenge ⚔️</button>
        </div>
        <div id='chat-container'>
            <div id='chat-sidebar'>
                <h2>Users</h2>
            </div>

            <div id='chat-main'>
                <div id='messages'></div>

                <div id='inputBar'>
                    <input type='text' id='msg' placeholder='Type your message here...' />
                    <button id='send'>Send</button>
                </div>
            </div>
        </div>
    </div>

    <div id='profile'>
        <!-- Right column: main profile info -->
        <div class='profile-info'>
            <div style='margin-top:12px; display:grid; grid-template-columns: repeat(2,1fr); gap:12px;'>
                <div class='panel'>
                    <div class='small'>Win %</div>
                    <div id='winPercent'>0</div>
                </div>
                <div class='panel'>
                    <div class='small'>Tokens</div>
                    <div id='tokens'>0</div>
                </div>
                <div class='panel'>
                    <div class='small'>Games started</div>
                    <div id='started'>0</div>
                </div>
                <div class='panel'>
                    <div class='small'>Games finished</div>
                    <div id='finished'>0</div>
                </div>
                <div class='panel'>
                    <div class='small'>W/D/L</div>
                    <div id='wdl'>0/0/0</div>
                </div>
            </div>
        </div>
    </div>

    <div id='buyTokens' class='panel'>
        <h3>Purchase tokens</h3>
        <input type='password' inputmode='numeric' pattern='[0-9]*' placeholder='Your PIN...' id='pinInput'
            class='input'>
        <input type='number' placeholder='Amount?' id='amount' class='input' min='1' value='1'>

        <div class='checkbox-item'>
            <input type='checkbox' id='saveToCookies' name='box'>
            <label for='saveToCookies'>Save PIN for quick pay?</label>
        </div>
        <p>Saving your pin will automatically purchase a token when you try to join a game without tokens.</p>

        <div class='actions'>
            <button id='submit' class='btn'>Buy (25)</button>
        </div>
    </div>

    <a href='/' class='small back-link'
        style='margin:8px 0 0 18px;display:inline-block;text-decoration:none;color:var(--muted); height:min-content'>←
        Back to games</a>
</body>

<script src='/socket.io/socket.io.js'></script>
<script src='js/socket.js'></script>

<script>
    const pinBox = document.getElementById('pinInput')
    const amount = document.getElementById('amount')
    const checkbox = document.getElementById('saveToCookies')
    const submit = document.getElementById('submit')

    function getCookie(name) {
        const nameEQ = name + "=";
        const ca = document.cookie.split(';');
        for (let i = 0; i < ca.length; i++) {
            let c = ca[i];
            while (c.charAt(0) === ' ') {
                c = c.substring(1, c.length); // Remove leading spaces
            }
            if (c.indexOf(nameEQ) === 0) {
                // Decode the cookie value
                return decodeURIComponent(c.substring(nameEQ.length, c.length));
            }
        }
        return null; // Return null if the cookie is not found
    }

    if (getCookie('pin')) checkbox.checked = true

    // guard: prevent buying less than 1 token
    submit.addEventListener('click', (e) => {
        const val = parseInt(amount.value) || 1
        if (val > 0) {
            socket.emit('purchaseToken', parseInt(pinBox.value) || null, val)
            socket.once('tokenTransactionComplete', () => {
                if (checkbox.checked) {
                    const exp = new Date()
                    exp.setFullYear(exp.getFullYear() + 1)
                    document.cookie = `pin=${encodeURIComponent(pinBox.value.trim())}; expires=${exp.toUTCString()}; path=/`
                } else {
                    document.cookie = `pin=0`
                }
                socket.emit('getUser', me.id)
            })
        }
    })
</script>

<script>
    const winPercent = document.getElementById('winPercent')
    const tokens = document.getElementById('tokens')
    const started = document.getElementById('started')
    const finished = document.getElementById('finished')
    const wdl = document.getElementById('wdl')
    const nameBox = document.getElementById('name')

    const query = window.location.search
    let viewingUser = new URLSearchParams(query).get('usr')

    // Hide purchase UI when viewing someone else's profile
    function updateBuyTokensVisibility() {
        const buy = document.getElementById('buyTokens')
        if (!buy) return
        // If we don't yet know the current user, wait for the server to tell us
        if (typeof me === 'undefined' || me == null) {
            socket.once('youAre', () => updateBuyTokensVisibility())
            return
        }
        // viewingUser may be null when visiting own profile with no query param
        if (viewingUser && String(viewingUser) !== String(me.id)) {
            buy.style.display = 'none'
        } else {
            buy.style.display = ''
        }
    }

    // Get the user data
    socket.on('foundUser', (user) => {
        updateInfo(user)
        console.log(user)
    })

    socket.on('noUser', () => {
        window.location.href = '/profile'
    })

    if (viewingUser) {
        socket.emit('getUser', viewingUser)
        updateBuyTokensVisibility()
    } else {
        socket.on('youAre', (u) => {
            viewingUser = u.id
            console.log(u)
            socket.emit('getUser', u.id)
            updateBuyTokensVisibility()
        })
    }

    function updateInfo(user) {
        winPercent.innerText = Math.round(user.wins / user.finished * 100 || 0)
        if (user.wins / user.finished * 100 == Infinity) {
            winPercent.innerText = '100'
        }
        tokens.innerText = user.tokens
        started.innerText = user.started
        finished.innerText = user.finished
        wdl.innerText = `${user.wins}/${user.draws}/${user.losses}`
        nameBox.innerText = user.display_name
    }
</script>

<script>
    const message = document.getElementById('chatOff')

    socket.on('chatOff', () => {
        if (!message) return;

        // Add visible class to trigger CSS transition
        message.classList.add('show');
        message.setAttribute('aria-hidden', 'false');

        // clear any previous hide timer
        if (message._chatOffTimeout) clearTimeout(message._chatOffTimeout);

        // hide after a few seconds
        message._chatOffTimeout = setTimeout(() => {
            // remove class so CSS transitions the element out
            message.classList.remove('show');
            message.setAttribute('aria-hidden', 'true');
            message._chatOffTimeout = null;
        }, 3000);
    });
</script>

<script>
    // User list population
    const users = document.getElementById('chat-sidebar')

    function populateUsers() {
        if (gameData && gameData.users) {
            users.innerHTML = ''

            // Helper to format milliseconds to MM:SS
            function formatMsToMMSS(ms) {
                if (!ms || ms < 0) return '00:00'
                const totalSeconds = Math.floor(ms / 1000)
                const minutes = Math.floor(totalSeconds / 60)
                const seconds = totalSeconds % 60
                return String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0')
            }

            let usersToShow = []
            if (gameData.prevWhite) usersToShow.push(gameData.prevWhite)
            if (gameData.prevBlack) usersToShow.push(gameData.prevBlack)

            gameData.users.forEach(u => {
                if (!usersToShow.some(user => user.id == u.id)) usersToShow.push(u)
            })

            usersToShow.forEach(u => {
                const userDiv = document.createElement('div')
                userDiv.classList.add('userdiv')
                const name = document.createElement('h3')
                const statusDot = document.createElement('div')
                name.classList.add('username')

                // Only create and append the inactive timestamp when the user is offline.
                // This keeps the status-dot flush against the username while online.
                let inactiveSpan = null
                if (!u.active && u.lastActiveAt) {
                    inactiveSpan = document.createElement('span')
                    inactiveSpan.classList.add('inactive-duration')
                    const elapsed = Date.now() - u.lastActiveAt
                    inactiveSpan.textContent = formatMsToMMSS(elapsed) + ' '
                }

                statusDot.classList.add('status-dot')
                // Determine online/offline by matching IDs (object identity may differ
                // for serialized `prevWhite`/`prevBlack` vs the live `gameData.users` entries).
                const liveUser = Array.isArray(gameData.users) ? gameData.users.find(x => x.id == u.id) : null
                if (liveUser && liveUser.active) {
                    statusDot.classList.add('online')
                } else {
                    statusDot.classList.add('offline')
                }

                // Add animation class when user is offline so CSS can sequence the slide + fade
                if (!u.active) {
                    userDiv.classList.add('went-offline')
                } else {
                    userDiv.classList.remove('went-offline')
                }

                // Make the name clickable to open the user's profile in a new tab
                if (u.id == me.id) {
                    name.innerText = `You (${u.side})`
                    name.style.cursor = 'pointer'
                    name.setAttribute('role', 'link')
                    name.setAttribute('title', 'View your profile page')
                    name.addEventListener('click', () => { window.open('/profile', '_blank') })
                } else {
                    name.innerText = `${u.displayName} (${u.side})`
                    name.style.cursor = 'pointer'
                    name.setAttribute('role', 'link')
                    name.setAttribute('title', `View ${u.displayName}'s profile page`)
                    name.addEventListener('click', () => { window.open(`/profile?usr=${u.id}`, '_blank') })
                }

                userDiv.appendChild(name)
                // insert inactive duration before the colored status dot when present
                if (inactiveSpan) userDiv.appendChild(inactiveSpan)
                userDiv.appendChild(statusDot)

                users.appendChild(userDiv)
            })
            // update waiting overlay after repopulating users
            try { updateWaitingOverlay(); } catch (e) { }
        }
    }
</script>

</html>