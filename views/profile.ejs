<!DOCTYPE html>
<html lang='en'>

<head>
    <meta charset='UTF-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <title>Profile - Chessbar</title>
    <link rel='stylesheet' href='/css/sidebar.css'>
    <link rel='stylesheet' href='/css/profile.css'>
</head>

<body class="with-sidebar">
    <%- include('partials/sidebar') %>
        <div id="player">
            <div class="avatar-large">
                <div class="pfp-container" style="position:relative; display:inline-block">
                    <div id="pfp"
                        style="background-image: url(<%= typeof avatarUrl !== 'undefined' ? avatarUrl : '/img/basic_avatar.png' %>)"
                        style="display:block; border-radius:50%; max-width:250px;"></div>
                    <div id="pfp-overlay">
                        Change profile picture</div>
                </div>
            </div>

            <div id="name"></div>
            <div id="btn-wrap">
                <button id="friends-btn" class="btn secondary"> <img src="/img/emoji-1.png" class="friend-emoji">Add
                    Friend<img src="/img/emoji-1.png" class="friend-emoji"></button>
                <button id="challenge-btn" class="btn secondary">⚔️ Challenge ⚔️</button>
            </div>
        </div>

        <div id='profile'>
            <!-- Right column: main profile info -->
            <div class='profile-info'>
                <div style='margin-top:12px; display:grid; grid-template-columns: repeat(2,1fr); gap:12px;'>
                    <div class='panel'>
                        <div class='small'>Win %</div>
                        <div id='winPercent'>0</div>
                    </div>
                    <div class='panel'>
                        <div class='small'>Tokens</div>
                        <div id='tokens'>0</div>
                    </div>
                    <div class='panel'>
                        <div class='small'>Games started</div>
                        <div id='started'>0</div>
                    </div>
                    <div class='panel'>
                        <div class='small'>Games finished</div>
                        <div id='finished'>0</div>
                    </div>
                    <div class='panel'>
                        <div class='small'>W/D/L</div>
                        <div id='wdl'>0/0/0</div>
                    </div>
                </div>
            </div>
        </div>

        <div id='buyTokens' class='panel'>
            <h3>Purchase tokens</h3>
            <input type='password' inputmode='numeric' pattern='[0-9]*' placeholder='Your PIN...' id='pinInput'
                class='input'>
            <input type='number' placeholder='Amount?' id='amount' class='input' min='1' value='1'>

            <div class='checkbox-item'>
                <input type='checkbox' id='saveToCookies' name='box'>
                <label for='saveToCookies'>Save PIN for quick pay?</label>
            </div>
            <p>Saving your pin will automatically purchase a token when you try to join a game without tokens.</p>

            <div class='actions'>
                <button id='submit' class='btn'>Buy (25)</button>
            </div>
        </div>

        <a href='/' class='small back-link'
            style='margin:8px 0 0 18px;display:inline-block;text-decoration:none;color:var(--muted); height:min-content'>←
            Back to games</a>
</body>

<script src='/js/sidebar.js'></script>
<script src='/socket.io/socket.io.js'></script>
<script src='js/socket.js'></script>
<script>
    // Expose whether this page is the signed-in user's own profile.
    // If `?usr=` is present and differs from the session user id, it's someone else's profile.
    (function () {
        try {
            const params = new URLSearchParams(window.location.search)
            const q = params.get('usr')
            const sessionUserId = <%= user && user.id ? user.id : 'null' %>
                // true if no query param (own profile) or query matches session id
                window.isOwnProfile = (!q) || String(q) === String(sessionUserId)
        } catch (e) { window.isOwnProfile = true }
    })()
</script>
<script src='/js/profilePfp.js'></script>

<script>
    const pinBox = document.getElementById('pinInput')
    const amount = document.getElementById('amount')
    const checkbox = document.getElementById('saveToCookies')
    const submit = document.getElementById('submit')

    function getCookie(name) {
        const nameEQ = name + "=";
        const ca = document.cookie.split(';');
        for (let i = 0; i < ca.length; i++) {
            let c = ca[i];
            while (c.charAt(0) === ' ') {
                c = c.substring(1, c.length); // Remove leading spaces
            }
            if (c.indexOf(nameEQ) === 0) {
                // Decode the cookie value
                return decodeURIComponent(c.substring(nameEQ.length, c.length));
            }
        }
        return null; // Return null if the cookie is not found
    }

    if (getCookie('pin')) checkbox.checked = true

    // guard: prevent buying less than 1 token
    submit.addEventListener('click', (e) => {
        const val = parseInt(amount.value) || 1
        if (val > 0) {
            socket.emit('purchaseToken', parseInt(pinBox.value) || null, val)
            socket.once('tokenTransactionComplete', () => {
                if (checkbox.checked) {
                    const exp = new Date()
                    exp.setFullYear(exp.getFullYear() + 1)
                    document.cookie = `pin=${encodeURIComponent(pinBox.value.trim())}; expires=${exp.toUTCString()}; path=/`
                } else {
                    document.cookie = `pin=0`
                }
                socket.emit('getUser', me.id)
            })
        }
    })
</script>

<script>
    const winPercent = document.getElementById('winPercent')
    const tokens = document.getElementById('tokens')
    const started = document.getElementById('started')
    const finished = document.getElementById('finished')
    const wdl = document.getElementById('wdl')
    const nameBox = document.getElementById('name')

    const query = window.location.search
    let viewingUser = new URLSearchParams(query).get('usr')

    // Hide purchase UI when viewing someone else's profile
    function updateBuyTokensVisibility() {
        const buy = document.getElementById('buyTokens')
        if (!buy) return
        // If we don't yet know the current user, wait for the server to tell us
        if (typeof me === 'undefined' || me == null) {
            socket.once('youAre', () => updateBuyTokensVisibility())
            return
        }
        // viewingUser may be null when visiting own profile with no query param
        if (viewingUser && String(viewingUser) !== String(me.id)) {
            buy.style.display = 'none'
        } else {
            buy.style.display = ''
        }
    }

    // Get the user data
    socket.on('foundUser', (user) => {
        updateInfo(user)
    })

    socket.on('noUser', () => {
        window.location.href = '/profile'
    })

    if (viewingUser) {
        socket.emit('getUser', viewingUser)
        updateBuyTokensVisibility()
    } else {
        socket.on('youAre', (u) => {
            viewingUser = u.id
            socket.emit('getUser', u.id)
            updateBuyTokensVisibility()
        })
    }

    function updateInfo(user) {
        winPercent.innerText = Math.round(user.wins / user.finished * 100 || 0)
        if (user.wins / user.finished * 100 == Infinity) {
            winPercent.innerText = '100'
        }
        tokens.innerText = user.tokens
        started.innerText = user.started
        finished.innerText = user.finished
        wdl.innerText = `${user.wins}/${user.draws}/${user.losses}`
        nameBox.innerText = user.display_name
    }
</script>

</html>