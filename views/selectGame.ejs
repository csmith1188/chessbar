<!DOCTYPE html>
<html lang='en'>

<head>
    <meta charset='UTF-8'>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <title>Chess</title>
    <link rel='stylesheet' href='/css/sidebar.css'>
    <link rel='stylesheet' href='/css/selectGame.css'>
    <link rel='stylesheet' href='/css/newGame.css'>
    <style>
        /* Simple nav message (appears when transfers fail) */
        .nav-message {
            display: none;
            margin-left: 12px;
            padding: 6px 10px;
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
            border-radius: 4px;
            font-size: 0.9rem
        }

        .nav-message.visible {
            display: inline-block
        }

        /* Message inside the new-game overlay */
        .overlay-message {
            display: none;
            margin-top: 8px;
            padding: 8px 10px;
            background: #f8d7da;
            color: #721c24;
            border: 1px solid #f5c6cb;
            border-radius: 4px;
            font-size: 0.95rem
        }

        .overlay-message.visible {
            display: block
        }
    </style>
</head>

<body class="with-sidebar">
    <%- include('partials/sidebar') %>
    <div id='newGameOverlay' class='overlay'>
        <div class='overlay-content'>
            <h1 id="newTitle">New Game</h1>
            <button class='closebtn' onclick='closeNav()'>&times;</button>

            <input type='text' class='input' id='gameName' placeholder='Enter Room Name...'>

            <div class='checkbox-group'>
                <div class='checkbox-item'>
                    <input type='checkbox' id='chatOn' name='chat' checked>
                    <label for='chatOn'>Chat enabled</label>
                </div>
                <div class='checkbox-item'>
                    <input type='checkbox' id='startWhite' name='white' checked>
                    <label for='startWhite'>Start as white</label>
                </div>
            </div>

            <input type='text' class='input' id='time' placeholder='How many minutes?'>

            <!-- <input type='text' class='input' id='payPin' placeholder='Enter your Formbar payment PIN...'> -->
            <div id='overlayMessage' class='overlay-message' aria-live='polite' role='status'></div>

            <button id='newPublicGame' class='btn' onclick="newGame('public')">New Public Game</button>
            <button id='newPrivateGame' class='btn secondary' onclick="newGame('private')">New Private Game</button>
        </div>
    </div>

    <!-- <span onclick='openNav()'>open</span> -->

    <div class='page-wrap'>
        <header class='header'>
            <div class='brand'>
                <img src='/img/basic/white_rook.png' alt='logo'>
                <h1>Chessbar — Select a Game</h1>
            </div>
            <div class='controls'>
                <!-- <a class='small' href='/game'>Open last game</a> -->
                <button id='newPublicGame' class='btn' onclick='openNav()'>New Game</button>
                <!-- show signed-in user or link to sign in -->
                <div id='navMessage' class='nav-message' aria-live='polite' role='status' style='display:none'></div>
                <div style='display:inline-block;margin-left:12px;vertical-align:middle'>
                    <% if (user && user.displayName) { %>
                        <span class='small'>Signed in as <strong>
                                <%= user.displayName %>
                            </strong></span>
                        <a class='small' href='/profile' style='margin-left:10px'>Profile</a>
                        <% if ([37,40].includes(Number(user && (user.id || user.formbar_id || user.user_id)) || 0)) { %>
                            <a class='small' href='/admin' style='margin-left:10px'>Admin</a>
                        <% } %>
                        <% } else { %>
                            <a class='small' href='/login'>Sign in</a>
                            <% } %>
                </div>
            </div>
        </header>

        <main class='main'>
            <section class='panel' id='games'>
                <h2>Available Games</h2>
                <ul id='gameList'></ul>
            </section>

            <aside class='sidebar'>
                <!-- <div class='panel' style='margin-bottom: 10px'>
                    <label for='joinCodeInput' class='small'>Formbar payment PIN</label>
                    <input class='input' type='text' id='pinInput' placeholder='Enter PIN'>
                    <div style='display:flex;gap:8px'>
                        <button id='pinInput' class='btn' onclick='savePin()'>Enter</button>
                    </div>

                    <div class='footer-note'>Saving your pin to cookies WILL take your digipogs without prompting you.
                        We are not stealing your digipogs.
                    </div>
                </div> -->

                <div class='panel'>
                    <label for='joinCodeInput' class='small'>Join by code</label>
                    <input class='input' type='text' id='joinCodeInput' placeholder='Enter Join Code'>
                    <div style='display:flex;gap:8px'>
                        <button id='joinGameButton' class='btn' onclick='joinGame()'>Join</button>
                        <button class='btn secondary' onclick='location.reload()'>Refresh</button>
                    </div>
                    <div class='footer-note'>Public games are visible to everyone. Private games require the join code.
                    </div>
                </div>
            </aside>
        </main>
    </div>
    <%- include('partials/notificationPopup') %>
    <script src='/js/sidebar.js'></script>
</body>
<script src='/socket.io/socket.io.js'></script>
<script src='js/socket.js'></script>

<script src='js/gameList.js'></script>

<script>
    // const payPin = document.getElementById('payPin')
    const joinCodeInput = document.getElementById('joinCodeInput');
    const gameName = document.getElementById('gameName')
    const chatOn = document.getElementById('chatOn')
    const startWhite = document.getElementById('startWhite')
    const timeAmount = document.getElementById('time')

    function newGame(visibility) {
        socket.emit('newGame', visibility, gameName.value.trim(), chatOn.checked, startWhite.checked, timeAmount.value * 60)
        // if (payPin.value) {
        // }
    }

    function joinGame() {
        const code = joinCodeInput.value.trim();
        if (code) {
            window.location.href = `/game?code=${encodeURIComponent(code)}`;
        }
    }

    const pinInput = document.getElementById('pinInput')

    function savePin() {
        let d = new Date()
        d.setTime(d.getTime() + (365 * 24 * 60 * 60 * 1000))
        let expires = 'expires=' + d.toUTCString()

        const PIN = pinInput.value
        if (!!Number(PIN)) {
            document.cookie = `pin=${PIN};${expires};path=/`
        }
    }
</script>

<script>
    function openNav() {
        document.getElementById('newGameOverlay').classList.add('active');
    }

    function closeNav() {
        document.getElementById('newGameOverlay').classList.remove('active');
    }

</script>

</html>