<!DOCTYPE html>
<html>

<head>
    <meta name='viewport' content='width=device-width, initial-scale=1.0'>
    <title>Game - Chessbar</title>
    <link rel='stylesheet' href='/css/game.css'>
    <link rel="stylesheet" href="/css/colors.css">
</head>

<body class="with-sidebar">
    <%- include('partials/sidebar') %>
        <div id='join-code-badge' role='button' tabindex='0' aria-live='polite' aria-label='Copy join code'
            title='Click to copy join code' style='display:none'></div>

        <div id='container'>
            <!-- Game canvas -->
            <div id="board-column">
                <canvas id='canvas'></canvas>
                <div id="underBoard">
                    <div id="blackCaptured"></div>
                    <div id="whiteClock"></div>
                    <div id='InfoBox'></div>
                    <button id="resign-btn" type="button" title="Resign" aria-label="Resign"></button>
                    //temp
                    <button id="rematch-button" type="button" title="rematch" aria-label="rematch">Rematch</button>
                    <div id="blackClock"></div>
                    <div id="whiteCaptured"></div>
                </div>
            </div>

            <!-- === Chat Section === -->
            <div id='chat-container'>
                <div id='chat-sidebar'>
                    <h2>Users</h2>
                </div>

                <div id='chat-main'>
                    <div id='messages'></div>

                    <div id='inputBar'>
                        <input type='text' id='msg' placeholder='Type your message here...' />
                        <button id='send'>Send</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Waiting overlay shown when opponent hasn't joined -->
        <div id="waitingOverlay" aria-live="polite" aria-hidden="true">
            <div class="waiting-inner" role="status">
                <div class="waiting-text">Waiting for opponent...</div>
            </div>
        </div>

        <!-- Pawn promotion menu (hidden, fixed top-center) -->
        <div id="promotion" aria-hidden="true">
            <img src="" id="queen">
            <img src="" id="rook">
            <img src="" id="bishop">
            <img src="" id="knight">
        </div>

        <a href='/' id='back-link'>Back to game selection</a>

        <!-- Settings button -->
        <button id='settings-btn' type='button' title='Settings' aria-label='Open settings'></button>

        <!-- Chat disabled message -->
        <div id="chatOff" aria-live="polite" aria-hidden="true">
            <div class="chat-off-message" role="status">
                This game does not allow chat. Sorry!
            </div>
        </div>

        <!-- Settings modal (hidden by default) -->
        <div id='settings-modal' role='dialog' aria-modal='true' aria-labelledby='settings-title'
            aria-hidden='true'>
            <div id='settings-panel'>
                <h3 id='settings-title'>Settings</h3>

                <div class='setting-row'>
                    <label for='boardSquareSize'>Board square size</label>
                    <input id='boardSquareSize' type='number' min='30' max='200' />
                </div>

                <div class='setting-row'>
                    <label for='lightSquareColor'>Light square color</label>
                    <input id='lightSquareColor' type='color' />
                </div>

                <div class='setting-row'>
                    <label for='moveColor'>Move Highlight Color:</label>
                    <input type='color' id='moveColor'>
                    <label for='moveAlpha'>Transparency (0-1):</label>
                    <input type='number' id='moveAlpha' min='0' max='1' step='0.01' value='0.31'>
                </div>

                <div class='setting-row'>
                    <label for='arrowColor'>Move Arrow Color:</label>
                    <input type='color' id='arrowColor'>
                    <label for='arrowAlpha'>Transparency (0-1):</label>
                    <input type='number' id='arrowAlpha' min='0' max='1' step='0.01' value='0.6'>
                </div>

                <div class='setting-row'>
                    <label for='arrowHeadBaseWidth'>Arrow head base width (px)</label>
                    <input id='arrowHeadBaseWidth' type='number' min='4' max='200' />
                </div>

                <div class='setting-row'>
                    <label for='darkSquareColor'>Dark square color</label>
                    <input id='darkSquareColor' type='color' />
                </div>

                <div class='setting-row'>
                    <label for='defaultPieceMargin'>Piece margin</label>
                    <input id='defaultPieceMargin' type='number' min='0' max='100' />
                </div>

                <div class='setting-row'>
                    <label for='hoverSizeIncrease'>Hover size increase</label>
                    <input id='hoverSizeIncrease' type='number' min='0' max='50' />
                </div>

                <div class='setting-row'>
                    <label for='pieceStyle'>Piece style</label>
                    <select id='pieceStyle'>
                        <option value='basic'>Basic</option>
                        <option value='goofy'>Goofy</option>
                        <option value='pixel'>Pixel</option>
                        <option value='neo'>Neo</option>
                    </select>
                </div>

                <fieldset class='setting-group'>
                    <legend>Debug</legend>
                    <label><input id='logMouseEvents' type='checkbox' /> Log mouse events</label>
                    <label><input id='showHoverSquare' type='checkbox' /> Show hover square</label>
                    <label><input id='showClickSquare' type='checkbox' /> Show click square</label>
                    <label><input id='logMoveEvents' type='checkbox' /> Log move events</label>
                </fieldset>

                <div class='settings-actions'>
                    <button id='export-pgn' type="button" title='Generate PGN from game moves'>Export PGN</button>
                    <button id='save-settings' type='button'>Save & reload</button>
                    <button id='reset-settings' type='button'>Reset</button>
                    <button id='close-settings' type='button' tabindex='0'>Close</button>
                </div>
            </div>
        </div>
        <%- include('partials/notificationPopup') %>
</body>
<!-- Socket.IO client -->
<script src='/socket.io/socket.io.js'></script>
<script src='js/socket.js'></script>

<!-- Game scripts -->
<script src='js/chat.js'></script>
<script src='js/settings.js'></script>
<script src='js/docEvents.js'></script>
<script src='js/clientBoard.js'></script>
<script src='js/main.js'></script>

<script>
    // Resign button
    const resign = document.getElementById('resign-btn')

    resign.onclick = function () {
        socket.emit('resign')
    }
    // temp rematch
    const rematchButton = document.getElementById('rematch-button');
    rematchButton.addEventListener('click', () => {
        socket.emit('rematch');
    });

</script>

<script>
    const message = document.getElementById('chatOff')

    socket.on('chatOff', () => {
        if (!message) return;

        // Add visible class to trigger CSS transition
        message.classList.add('show');
        message.setAttribute('aria-hidden', 'false');

        // clear any previous hide timer
        if (message._chatOffTimeout) clearTimeout(message._chatOffTimeout);

        // hide after a few seconds
        message._chatOffTimeout = setTimeout(() => {
            // remove class so CSS transitions the element out
            message.classList.remove('show');
            message.setAttribute('aria-hidden', 'true');
            message._chatOffTimeout = null;
        }, 3000);
    });
</script>

<script>
    // User list population
    const users = document.getElementById('chat-sidebar')

    function populateUsers() {
        if (gameData && gameData.users) {
            users.innerHTML = ''

            let usersToShow = []
            if (gameData.prevWhite) usersToShow.push(gameData.prevWhite)
            if (gameData.prevBlack) usersToShow.push(gameData.prevBlack)

            gameData.users.forEach(u => {
                if (!usersToShow.some(user => user.id == u.id)) usersToShow.push(u)
            })

            usersToShow.forEach(u => {
                const userDiv = document.createElement('div')
                userDiv.classList.add('userdiv')
                const name = document.createElement('h3')
                const statusDot = document.createElement('div')
                name.classList.add('username')

                // Only create and append the inactive timestamp when the user is offline.
                // This keeps the status-dot flush against the username while online.
                let inactiveSpan = null
                if (!u.active && u.lastActiveAt) {
                    inactiveSpan = document.createElement('span')
                    inactiveSpan.classList.add('inactive-duration')
                    inactiveSpan.dataset.lastActiveAt = u.lastActiveAt
                    const elapsed = Date.now() - u.lastActiveAt
                    inactiveSpan.textContent = formatMsToMMSS(elapsed) + ' '
                }

                statusDot.classList.add('status-dot')
                // Determine online/offline by matching IDs (object identity may differ
                // for serialized `prevWhite`/`prevBlack` vs the live `gameData.users` entries).
                const liveUser = Array.isArray(gameData.users) ? gameData.users.find(x => x.id == u.id) : null
                if (liveUser && liveUser.active) {
                    statusDot.classList.add('online')
                } else {
                    statusDot.classList.add('offline')
                }

                // Add animation class when user is offline so CSS can sequence the slide + fade
                if (!u.active) {
                    userDiv.classList.add('went-offline')
                } else {
                    userDiv.classList.remove('went-offline')
                }

                // Make the name clickable to open the user's profile in a new tab
                if (u.id == me.id) {
                    name.innerText = `You (${u.side})`
                    name.style.cursor = 'pointer'
                    name.setAttribute('role', 'link')
                    name.setAttribute('title', 'View your profile page')
                    name.addEventListener('click', () => { window.open('/profile', '_blank') })
                } else {
                    name.innerText = `${u.displayName} (${u.side})`
                    name.style.cursor = 'pointer'
                    name.setAttribute('role', 'link')
                    name.setAttribute('title', `View ${u.displayName}'s profile page`)
                    name.addEventListener('click', () => { window.open(`/profile?usr=${u.id}`, '_blank') })
                }

                userDiv.appendChild(name)
                // insert inactive duration before the colored status dot when present
                if (inactiveSpan) userDiv.appendChild(inactiveSpan)
                userDiv.appendChild(statusDot)

                users.appendChild(userDiv)
            })
            // update waiting overlay after repopulating users
            try { updateWaitingOverlay(); } catch (e) { }
        }
    }

    // Helper to format milliseconds to MM:SS (also used by the update timer)
    function formatMsToMMSS(ms) {
        if (!ms || ms < 0) return '00:00'
        const totalSeconds = Math.floor(ms / 1000)
        const minutes = Math.floor(totalSeconds / 60)
        const seconds = totalSeconds % 60
        return String(minutes).padStart(2, '0') + ':' + String(seconds).padStart(2, '0')
    }

    // Continuously update inactive duration clocks for offline players
    setInterval(() => {
        // Don't update the clock if the game is finished
        if (gameData && gameData.finished) return

        const inactiveDurationElements = document.querySelectorAll('.inactive-duration')
        inactiveDurationElements.forEach(span => {
            const lastActiveAt = parseInt(span.dataset.lastActiveAt)
            if (lastActiveAt) {
                const elapsed = Date.now() - lastActiveAt
                span.textContent = formatMsToMMSS(elapsed) + ' '
            }
        })
    }, 1000)

</script>

<script>
    // Show/hide the waiting-for-opponent overlay based on current users
    function updateWaitingOverlay() {
        const overlay = document.getElementById('waitingOverlay')
        if (!overlay) return

        // Determine whether an opponent (a different, active player) is present
        let hasOpponent = false
        try {
            if (typeof me !== 'undefined' && me && gameData && Array.isArray(gameData.users)) {
                // Prefer a user on the opposite side if side is known
                if (me.side) {
                    hasOpponent = gameData.prevBlack && gameData.prevWhite
                }
                // Fallback: any other connected user counts as an opponent
                if (!hasOpponent) hasOpponent = gameData.users.some(u => u.id !== me.id)
            } else if (gameData && Array.isArray(gameData.users)) {
                hasOpponent = gameData.users.length >= 2
            }
        } catch (e) {
            hasOpponent = true
        }

        if (!hasOpponent) {
            overlay.classList.add('show')
            overlay.setAttribute('aria-hidden', 'false')
        } else {
            overlay.classList.remove('show')
            overlay.setAttribute('aria-hidden', 'true')
        }
    }

    // Ensure overlay updates when board and identity info arrive
    socket.on('updateBoard', (data) => {
        // existing handler in this file already calls updateBoard and populateUsers;
        // call updateWaitingOverlay again in case users changed
        try { updateWaitingOverlay(); } catch (e) { }
    })

    socket.on('youAre', () => {
        // identity may have changed; refresh overlay
        try { updateWaitingOverlay(); } catch (e) { }
    })
</script>

<script>
    socket.on('noGame', () => {
        window.location.href = '/'
    })

    const joinCode = new URLSearchParams(window.location.search).get('code');
    if (joinCode) {
        socket.emit('join', joinCode);
    }

    // Join-code badge element (will be populated from server `youAre` or the URL)
    const joinBadge = document.getElementById('join-code-badge');

    const InfoBox = document.getElementById('InfoBox');
    socket.on('updateBoard', (data) => {
        updateBoard(data)
        populateUsers()
        InfoBox.innerText = data.board.turn == "white" ? "White's turn" : "Black's turn";
        // CapturedW.innerHTML = '';
        // CapturedB.innerHTML = '';
    });

    // Listen for server-sent identity info which includes game joinCode when in a game
    socket.on('youAre', (me) => {
        try {
            let code = null;
            if (me && me.game && me.game.joinCode) {
                code = String(me.game.joinCode);
            } else if (joinCode) {
                code = String(joinCode);
            }

            if (code) {
                joinBadge.textContent = `Join code: ${code}`;
                joinBadge.dataset.code = code;
                joinBadge.style.display = 'block';
            } else {
                joinBadge.dataset.code = '';
                joinBadge.style.display = 'none';
            }
        } catch (e) {
            // Ignore errors and hide badge
            joinBadge.dataset.code = '';
            joinBadge.style.display = 'none';
        }
    });

    // Copy-to-clipboard helper with fallback
    async function copyJoinCode(code) {
        if (!code) return;
        const prev = joinBadge.textContent;
        try {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                await navigator.clipboard.writeText(code);
            } else {
                // Fallback for older browsers
                const ta = document.createElement('textarea');
                ta.value = code;
                ta.style.position = 'fixed';
                ta.style.left = '-9999px';
                document.body.appendChild(ta);
                ta.select();
                document.execCommand('copy');
                document.body.removeChild(ta);
            }
            // show visual confirmation
            joinBadge.textContent = 'Copied!';
            setTimeout(() => {
                joinBadge.textContent = prev;
            }, 1400);
        } catch (err) {
            console.error('Copy failed', err);
            // brief error feedback
            joinBadge.textContent = 'Copy failed';
            setTimeout(() => {
                joinBadge.textContent = prev;
            }, 1400);
        }
    }

    // Click and keyboard handlers for accessibility
    joinBadge.addEventListener('click', () => {
        copyJoinCode(joinBadge.dataset.code);
    });

    joinBadge.addEventListener('keydown', (e) => {
        if (e.key === 'Enter' || e.key === ' ' || e.key === 'Spacebar') {
            e.preventDefault();
            copyJoinCode(joinBadge.dataset.code);
        }
    });
</script>

<script>
    var whiteTime = null;
    var blackTime = null;

    socket.on('updateClock', (data) => {
        if (data.whiteTime !== undefined) {
            whiteTime = data.whiteTime;
            document.getElementById('whiteClock').innerText = formatTime(whiteTime);
        }
        if (data.blackTime !== undefined) {
            blackTime = data.blackTime;
            document.getElementById('blackClock').innerText = formatTime(blackTime);
        }

    });

</script>

<script src='/js/sidebar.js'></script>

</html>