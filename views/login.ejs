<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign in — Chessbar</title>
    <link rel="stylesheet" href="/css/selectGame.css">
</head>

<body>
    <div class="page-wrap">
        <header class="header">
            <div class="brand">
                <img src="/img/basic/white_rook.png" alt="logo">
                <h1>Chessbar — Sign in</h1>
            </div>
            <div class="controls">
                <!-- <a class="small" href="/">Back</a> -->
            </div>
        </header>

        <main style="display:flex;justify-content:center;">
            <section class="panel" style="max-width:480px;width:100%;text-align:center;">
                <!-- <h2>Sign in</h2> -->

                <p>
                    <a id="formbarSignIn" class="btn" href="<%= authUrl %>/oauth?redirectURL=<%= encodeURIComponent(thisUrl) %>">Sign in with Formbar</a>
                </p>

                <p class="small">If you were redirected back with a token, you'll be signed in and returned to the home page.</p>
            </section>
        </main>
    </div>
</body>

</html>